# Pipeline GridRisk — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores

# Conexão com o banco PostgreSQL/PostGIS
DATABASE_URL=postgresql://griduser:gridpass@localhost:5432/gridrisk

# (Opcional) Diretório onde ficam os arquivos .gpkg da BDGD
# Usado pelo worker BullMQ ao executar ingest_bdgd.py via Docker
BDGD_DATA_DIR=/data
